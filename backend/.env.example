# Environment Configuration
PROJECT_NAME="Finance Web Application"
API_V1_STR="/api/v1"
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "http://localhost:3002", "http://127.0.0.1:3002"]
FRONTEND_URL=http://localhost:3002

# Supabase PostgreSQL Database URL (asyncpg format)
# Example: postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Or with Pooler (Port 6543 / 5432): postgresql+asyncpg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Supabase REST Storage API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=finance-invoices

# Multi-Tenancy & Security
AUTH_SECRET_KEY=your-jwt-signing-secret-key-min-32-chars
TOKEN_ENCRYPTION_KEY=your-fernet-token-encryption-key-32-bytes
DEFAULT_TENANT_ID=default-tenant-001

# Zoho Books OAuth Integration
ZOHO_CLIENT_ID=your-zoho-client-id
ZOHO_CLIENT_SECRET=your-zoho-client-secret
ZOHO_REDIRECT_URI=http://localhost:8000/api/v1/zoho/callback
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_BOOKS_API_BASE_URL=https://www.zohoapis.in/books/v3

# Colab Qwen3-VL, Qwen3-4B COA & Qwen3-4B/Groq TDS Inference Endpoints
QWEN_VL_SERVICE_URL=https://your-vlm-ngrok-tunnel.ngrok-free.dev
QWEN_COA_SERVICE_URL=https://your-coa-ngrok-tunnel.ngrok-free.dev
QWEN_TDS_SERVICE_URL=https://your-tds-ngrok-tunnel.ngrok-free.dev

# Legacy variables (for backward compatibility)
COLAB_API_URL=https://your-vlm-ngrok-tunnel.ngrok-free.dev
COLAB_ACCOUNTING_API_URL=https://your-coa-ngrok-tunnel.ngrok-free.dev
COLAB_TDS_API_URL=https://your-tds-ngrok-tunnel.ngrok-free.dev
INFERENCE_TIMEOUT=900
